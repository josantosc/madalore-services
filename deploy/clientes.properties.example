# Montado no container em /app/config/clientes.properties (Coolify: Storages > File Mount).
# Uma conta do Chatwoot por clinica. Conta sem cadastro usa as variaveis globais.

mandalore.clientes.1.chatwoot-token=
mandalore.clientes.1.webhook-secret=
mandalore.clientes.1.tasy.url=jdbc:oracle:thin:@//ip-ou-dns-da-clinica:1521/SERVICO
mandalore.clientes.1.tasy.username=
mandalore.clientes.1.tasy.password=

# Clinica sem integracao: o bot marca na agenda do Mandalore (AGENDA_ENABLED=true) e a recepcao
# repete no sistema da clinica pelas pendencias da tela /agenda. Ver docs/agenda-mandalore.md.
# mandalore.clientes.3.chatwoot-token=
# mandalore.clientes.3.agenda=mandalore
# mandalore.clientes.3.recepcao.usuario=recepcao-clinica3
# mandalore.clientes.3.recepcao.senha=
