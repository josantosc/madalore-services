# Variaveis de producao do Mandalore. Cole no Coolify em Environment Variables
# e marque como secretas as senhas, tokens e o JSON do Google.

# Chatwoot
CHATWOOT_BASE_URL=https://chat.seudominio.com.br
CHATWOOT_API_TOKEN=
CHATWOOT_WEBHOOK_SECRET=
CHATWOOT_ACCOUNT_ID=
# IDs das equipes do Chatwoot que recebem o transbordo (numero na URL da equipe)
CHATWOOT_EQUIPE_RECEPCAO=
CHATWOOT_EQUIPE_LABORATORIO=
CHATWOOT_EQUIPE_FATURAMENTO=
# Conversas com pendencia da agenda do Mandalore (vazio: equipe da recepcao)
CHATWOOT_EQUIPE_AGENDAMENTO=

# Orcamento por foto do pedido (Gemini no Vertex AI). Requer observabilidade no PostgreSQL
# e o papel "Vertex AI User" na conta de servico do DIALOGFLOW_CREDENTIALS. Ver docs/orcamento-pedido.md.
ORCAMENTO_ENABLED=false
# GEMINI_PROJECT_ID=   (padrao: DIALOGFLOW_PROJECT_ID)
# GEMINI_LOCATION=global
# GEMINI_MODEL=gemini-3.8-flash

# Dialogflow ES. DIALOGFLOW_CREDENTIALS aceita o JSON inteiro da conta de servico numa linha.
DIALOGFLOW_PROJECT_ID=
DIALOGFLOW_CREDENTIALS=
DIALOGFLOW_WEBHOOK_USER=
DIALOGFLOW_WEBHOOK_PASSWORD=
DIALOGFLOW_ENVIRONMENT=
DIALOGFLOW_LOCATION=

# Oracle do Tasy da clinica (porta liberada so para o IP do VPS)
ORACLE_JDBC_URL=jdbc:oracle:thin:@//ip-ou-dns-da-clinica:1521/SERVICO
ORACLE_USER=
ORACLE_PASSWORD=

# Gravacao do agendamento. Troque para "tasy" depois da homologacao.
AGENDAMENTO_ESCRITA=agendamento-ds
TASY_ESCRITA_USUARIO=MANDALORE

# WhatsApp direto pela Twilio. Deixe false se o WhatsApp entrar pelo Chatwoot.
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+55XXXXXXXXXXX
TWILIO_WEBHOOK_URL=https://api.seudominio.com.br/twilio/whatsapp
TWILIO_STATUS_CALLBACK_URL=https://api.seudominio.com.br/twilio/whatsapp/status

# Trilha operacional (banco "mandalore" no Postgres do Coolify)
OBSERVABILITY_POSTGRES_ENABLED=true
OBSERVABILITY_POSTGRES_INITIALIZE_SCHEMA=true
OBSERVABILITY_POSTGRES_JDBC_URL=jdbc:postgresql://<host-interno-do-postgres>:5432/mandalore
OBSERVABILITY_POSTGRES_USER=mandalore
OBSERVABILITY_POSTGRES_PASSWORD=
# false: não guarda a fala do paciente (curadoria fica só com intent, confiança e fallback)
OBSERVABILITY_CURADORIA_TEXTO=true

# Central de administração em /admin: um login para curadoria, tabela de preços e simulador.
# ADMIN_USER entra em tudo e é o acesso de emergência (funciona sem banco). As pessoas da equipe são
# cadastradas na tela /usuarios e entram com o e-mail (exige OBSERVABILITY_POSTGRES_ENABLED=true).
# Ver docs/usuarios-perfis.md. CURADORIA_USER e PRECOS_USER (opcionais) entram só na própria tela.
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_NOME=BioSaúde
ADMIN_CHATWOOT_URL=https://bs-chat.jscinfor.com

# Tela de curadoria em /curadoria (ensinar exige "Dialogflow API Admin")
CURADORIA_ENABLED=true
CURADORIA_USER=
CURADORIA_PASSWORD=
CURADORIA_LIMITE_CONFIANCA=0.6

# Relatorios lidos pelo OpenClaw: resumo da curadoria e relatorio do gestor. Ver docs/relatorios-openclaw.md.
# OPENCLAW_TOKEN: segredo longo (ex.: openssl rand -hex 32), o mesmo configurado no OpenClaw.
RELATORIOS_ENABLED=false
OPENCLAW_TOKEN=
RELATORIOS_URL=https://bs-api.jscinfor.com
# Envio direto pelo Telegram do Mandalore, sem o OpenClaw. Cron "-" desliga um dos dois.
RELATORIOS_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RELATORIO_CURADORIA_CRON=0 0 8 * * *
RELATORIO_GESTOR_CRON=0 0 8 * * MON

# Orcamento por foto do pedido (Gemini) e tela do financeiro em /precos
ORCAMENTO_ENABLED=true
GEMINI_MODEL=gemini-3.8-flash
PRECOS_USER=financeiro
PRECOS_PASSWORD=

# Agenda do Mandalore em /agenda, para clinicas sem integracao. Ver docs/agenda-mandalore.md.
# AGENDA_ORIGEM=mandalore faz o bot marcar nesta agenda (por conta: mandalore.clientes.<id>.agenda).
AGENDA_ENABLED=false
AGENDA_ORIGEM=tasy
AGENDA_USER=recepcao
AGENDA_PASSWORD=
AGENDA_PRAZO_MINUTOS=30
AGENDA_ANTECEDENCIA_MINUTOS=60
AGENDA_PENDENCIA_CONFIRMACAO=false

# Funil de orcamentos em /funil. Ver docs/funil-orcamento.md.
# O webhook do Chatwoot precisa tambem do evento "Conversa atualizada" (conversation_updated).
FUNIL_ENABLED=false
# Opcional: login que so abre o funil. O ADMIN_USER ja entra.
FUNIL_USER=
FUNIL_PASSWORD=
# Cadencia inicial de cada clinica, ate o gestor gravar a dela na tela /funil: dias uteis ate cada contato
# ("1,2,2" = 3 contatos), dias uteis sem resposta depois do ultimo para fechar como perdida e sabado como dia util.
# Feriados nacionais sao calculados; os locais a clinica cadastra na tela.
FUNIL_CADENCIA=1,2,2
FUNIL_DIAS_ENCERRAMENTO=2
FUNIL_SABADO_UTIL=false
# Limite de seguranca em dias corridos sem mensagem do paciente, mesmo com contatos pendentes.
FUNIL_DIAS_SEM_RESPOSTA=30

# Simulador em /simulador (só ADMIN_USER). Gera conversas reais no Chatwoot: ligue só para testes.
SIMULADOR_ENABLED=false

# Memoria da JVM. Ajuste junto com o limite de memoria do container.
JAVA_OPTS=-Xms256m -Xmx1g -XX:+ExitOnOutOfMemoryError
